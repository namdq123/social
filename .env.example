# MySQL (dùng bên trong mạng Docker; không cần đổi nếu chạy bằng docker compose)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=seedance
MYSQL_USER=seedance
MYSQL_PASSWORD=seedance

# Có thể để trống và nhập sau trên giao diện Cài đặt.
# API key lấy tại https://openrouter.ai/keys
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://openrouter.ai/api/v1

# OAuth client loại Web application trên Google Cloud.
# Redirect URI phải khớp: http://localhost:8080/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PUBLIC_BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
